# =============================================================================
# Authentication & Security Course — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — required for quiz scores, leaderboard, live sessions, admin auth
# Find these in: Supabase dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Your Supabase project URL (safe to expose — always NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon key — safe to expose, RLS enforces access control
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Supabase service role key — SERVER ONLY, never expose to the browser
# Used by: scripts/seed-questions.ts (one-time seed)
# Find in: Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# =============================================================================
# SETUP CHECKLIST
# =============================================================================
# 1. Create a Supabase project at https://supabase.com
# 2. Run the SQL schema (see .planning/specs/epics/epic-quiz-engine.md and
#    epic-admin.md for the full CREATE TABLE statements)
# 3. Enable Row Level Security on all tables (see epic-admin.md for RLS policies)
# 4. Create your admin account:
#    Supabase dashboard → Authentication → Users → Add user
# 5. Run the seed script to populate questions:
#    npx tsx scripts/seed-questions.ts
# 6. Copy this file to .env.local and fill in the values above
# =============================================================================
